        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class Main {\n        &lt;&lt;final&gt;&gt;\n        -Main()\n        +main(String[] args)$ void\n        -criarTreinador(Scanner sc, String letra)$ Treinador\n        -escolherPokeSal(Scanner sc, String nomeTreinador)$ PokeSal\n        -escolherMochila(Scanner sc, String nomeTreinador)$ Mochila\n        -lerOpcao(Scanner sc)$ int\n        -anunciarVencedor(Treinador vencedor, Treinador perdedor)$ void\n        -aplicarEfeitosDeFimDeTurno(Treinador treinador, Batalha batalha)$ void\n        -executarTurno(Treinador atacante, Treinador defensor, Batalha batalha, Scanner sc)$ boolean\n    }\n\n    class Batalha {\n        -Treinador treinadorA\n        -Treinador treinadorB\n        -TipoTerreno terreno\n        -Random random\n        +Batalha(Treinador treinadorA, Treinador treinadorB)\n        +Batalha(Treinador treinadorA, Treinador treinadorB, TipoTerreno terreno)\n        +getTerreno() TipoTerreno\n        +definirOrdemDeIniciativa() List~Treinador~\n        +calcularMultiplicadorElemental(TipoElemental atacante, TipoElemental defensor) double\n        +executarAtaque(PokeSal atacante, PokeSal defensor) ResultadoAtaque\n        +aplicarBonusDeTerreno(double danoBase, TipoElemental tipoAtacante) double\n        +aplicarEfeitoDeTerrenoNoFimDoTurno(PokeSal pokeSal) void\n    }\n\n    class ResultadoAtaque {\n        -boolean critico\n        -int danoCausado\n        -double multiplicadorEfetividade\n        +ResultadoAtaque(boolean critico, int danoCausado, double multiplicadorEfetividade)\n        +isCritico() boolean\n        +getDanoCausado() int\n        +getMultiplicadorEfetividade() double\n    }\n\n    class Treinador {\n        -String nome\n        -PokeSal pokeSalAtivo\n        -Mochila mochila\n        +Treinador(String nome, PokeSal pokeSalAtivo, Mochila mochila)\n        +getNome() String\n        +getPokeSalAtivo() PokeSal\n        +getMochila() Mochila\n    }\n\n    class PokeSal {\n        &lt;&lt;abstract&gt;&gt;\n        -TipoElemental tipo\n        -int hpMaximo\n        -String nome\n        -int hpAtual\n        -int atk\n        -int def\n        -int spd\n        -StatusEfeito statusAtivo\n        #PokeSal(String nome, TipoElemental tipo, int hpMaximo, int atk, int def, int spd)\n        +getNome() String\n        +getTipo() TipoElemental\n        +getHpMaximo() int\n        +getHpAtual() int\n        +getDef() int\n        +getSpd() int\n        +getStatusAtivo() StatusEfeito\n        +setStatusAtivo(StatusEfeito statusAtivo) void\n        +receberDano(int dano) void\n        +curar(int cura) void\n        +estaVivo() boolean\n        +aplicarEfeitoDeStatusNoFimDoTurno() void\n        +getAtkEfetivo() int\n    }\n\n    class CharSal {\n        -HP_BASE$ int = 90\n        -ATK_BASE$ int = 22\n        -DEF_BASE$ int = 16\n        -SPD_BASE$ int = 20\n        +CharSal()\n    }\n\n    class SquirtSal {\n        -HP_BASE$ int = 95\n        -ATK_BASE$ int = 17\n        -DEF_BASE$ int = 22\n        -SPD_BASE$ int = 16\n        +SquirtSal()\n    }\n\n    class BulbaSal {\n        -HP_BASE$ int = 100\n        -ATK_BASE$ int = 18\n        -DEF_BASE$ int = 20\n        -SPD_BASE$ int = 15\n        +BulbaSal()\n    }\n\n    class CyndaSal {\n        -HP_BASE$ int = 88\n        -ATK_BASE$ int = 23\n        -DEF_BASE$ int = 15\n        -SPD_BASE$ int = 21\n        +CyndaSal()\n    }\n\n    class ChikoSal {\n        -HP_BASE$ int = 98\n        -ATK_BASE$ int = 16\n        -DEF_BASE$ int = 21\n        -SPD_BASE$ int = 17\n        +ChikoSal()\n    }\n\n    class TotoSal {\n        -HP_BASE$ int = 97\n        -ATK_BASE$ int = 19\n        -DEF_BASE$ int = 19\n        -SPD_BASE$ int = 15\n        +TotoSal()\n    }\n\n    class Item {\n        &lt;&lt;interface&gt;&gt;\n        +usar(PokeSal alvo) void\n        +getNome() String\n    }\n\n    class Potion {\n        -CURA_POTION$ int = 20\n        +usar(PokeSal alvo) void\n        +getNome() String\n    }\n\n    class SuperPotion {\n        -CURA_SUPER_POTION$ int = 50\n        +usar(PokeSal alvo) void\n        +getNome() String\n    }\n\n    class Antidote {\n        +usar(PokeSal alvo) void\n        +getNome() String\n    }\n\n    class Mochila {\n        -List~Item~ itens\n        +adicionarItem(Item item) void\n        +getItens() List~Item~\n        +remove(Item itemSelecionado) void\n    }\n\n    class TipoElemental {\n        &lt;&lt;enumeration&gt;&gt;\n        FOGO\n        AGUA\n        PLANTA\n    }\n\n    class StatusEfeito {\n        &lt;&lt;enumeration&gt;&gt;\n        QUEIMADO\n        ENVENENADO\n        NENHUM\n    }\n\n    class TipoTerreno {\n        &lt;&lt;enumeration&gt;&gt;\n        ASFALTO_QUENTE\n        POCA_DE_CHUVA\n        CANTEIRO_CENTRAL\n        NEUTRO\n        -RANDOM$ Random\n        +terrenoAleatorio()$ TipoTerreno\n    }\n\n    class BalanceamentoConstantes {\n        &lt;&lt;final&gt;&gt;\n        +SUPER_EFETIVO$ double = 2.0\n        +POUCO_EFETIVO$ double = 0.5\n        +NEUTRO$ double = 1.0\n        +BONUS_ASFALTO_QUENTE$ double = 0.15\n        +BONUS_POCA_DE_CHUVA$ double = 0.10\n        +CURA_CANTEIRO_CENTRAL$ double = 0.05\n        +MAXIMO_ITENS_MOCHILA$ int = 2\n        +HP_MINIMO$ int = 0\n        +CHANCE_CRITICO$ double = 0.12\n        +PODER_BASE_ATAQUE$ int = 10\n        +CHANCE_QUEIMADURA$ double = 0.10\n        +CHANCE_ENVENENAMENTO$ double = 0.30\n        -BalanceamentoConstantes()\n    }\n\n    PokeSal &lt;|-- CharSal\n    PokeSal &lt;|-- SquirtSal\n    PokeSal &lt;|-- BulbaSal\n    PokeSal &lt;|-- CyndaSal\n    PokeSal &lt;|-- ChikoSal\n    PokeSal &lt;|-- TotoSal\n\n    Item &lt;|.. Potion\n    Item &lt;|.. SuperPotion\n    Item &lt;|.. Antidote\n\n    Batalha o-- \&quot;2\&quot; Treinador : treinadorA / treinadorB\n    Batalha --&gt; \&quot;1\&quot; TipoTerreno : terreno\n    Batalha ..&gt; ResultadoAtaque : cria\n    Batalha ..&gt; PokeSal : ataca / cura\n    Batalha .